# SpeechInt configuration. Copy to .env and adjust.
#
#   cp .env.example .env
#   docker compose up -d
#
# Every variable has a working default, so an empty .env also starts.
#
# ── Mindestanforderungen an den Endpunkt ─────────────────────────────────────
# Dimensioniert ist dieser Dienst für:
#     mindestens 6 CPU-Kerne mit AVX2 (x86-64) und mindestens 16 GB RAM
# Die Thread-Vorgaben unten entsprechen diesen sechs Kernen. Weniger geht auch,
# ist aber langsamer; der Gateway protokolliert die Abweichung beim Start und
# meldet sie unter GET /v1/config im Feld "host".

# ── Public API of the gateway ─────────────────────────────────────────────────
# Host port the API is published on. LLMInt's speech endpoint points here.
SPEECHINT_PORT=8080
# Shared secret. When set, clients must send it as X-Auth-Token (or
# "Authorization: Bearer <token>"); requests without it get HTTP 401.
# Generate one with: openssl rand -hex 32
SPEECHINT_TOKEN=
# Upper size of one audio segment. Dictation sends short segments, so 25 MB is
# generous; larger uploads are rejected with HTTP 413.
SPEECHINT_MAX_AUDIO_MB=25
# How much already-written text the dictation model sees as read-only context.
SPEECHINT_MAX_CONTEXT_CHARS=400
# Spoken language used when a request carries none.
SPEECHINT_DEFAULT_LANGUAGE=de
# Sampling temperature for the dictation model. Low keeps the model from
# rewriting; raise slightly if the output feels too rigid.
SPEECHINT_TEMPERATURE=0.1
# DEBUG / INFO / WARNING / ERROR. Dictated text is never logged.
SPEECHINT_LOG_LEVEL=INFO
# Image tag for the gateway build.
SPEECHINT_IMAGE_TAG=local
# Memory ceiling of the gateway container; it only makes HTTP calls.
SPEECHINT_MEM_LIMIT=512m

# ── Speech recognition (whisper.cpp container) ────────────────────────────────
# Optional shared secret between gateway and whisper.cpp. When set, the
# gateway sends it as X-Auth-Token and whisper.cpp requires it (--api-key).
WHISPER_TOKEN=
# Seconds the gateway waits for one transcription.
WHISPER_TIMEOUT=120
# ggml model name (tiny/base/small/medium/large-v3, plus .en and quantised
# variants). "small" is the recommended compromise for German dictation.
WHISPER_MODEL=small
# Spoken language passed to the recogniser ("auto" for auto-detection).
WHISPER_LANGUAGE=de
# CPU threads used for inference. Six matches the reference machine; whisper.cpp
# scales up to about eight threads.
WHISPER_THREADS=6
# Memory ceiling of the whisper container. "small" needs ~1 GB once loaded.
WHISPER_MEM_LIMIT=2g
WHISPER_MEM_RESERVATION=1g
# Image tag, e.g. main-cuda / main-vulkan for GPU hosts.
WHISPER_IMAGE_TAG=main
# Platform for the upstream image. Only linux/amd64 exists upstream; on arm64
# use docker-compose.arm64.yml, which builds natively instead.
WHISPER_PLATFORM=linux/amd64

# ── Dictation model (Qwen3.5-2B Q4 via llama.cpp container) ───────────────────
# Optional shared secret between gateway and llama.cpp.
LLM_TOKEN=
# Seconds the gateway waits for one dictation-processing call.
LLM_TIMEOUT=60
# GGUF source. The default repo ships Q4_K_M, the quantisation used by default.
LLM_GGUF_REPO=unsloth/Qwen3.5-2B-GGUF
LLM_GGUF_FILE=Qwen3.5-2B-Q4_K_M.gguf
# Model id reported by the server; the gateway sends it with every request.
LLM_MODEL_ALIAS=Qwen3.5-2B Q4
# Context window in tokens, shared by all slots (unified KV cache). Dictation
# fragments are short, 4096 is plenty; raise it for several concurrent slots.
LLM_CTX_SIZE=4096
# Concurrent dictation slots. 1 serialises requests, which matches six cores;
# raise together with LLM_CTX_SIZE if several dictations must overlap.
LLM_PARALLEL=1
# CPU threads for inference and prompt processing. Six matches the reference
# machine; a 2B model does not get faster with more than one thread per core.
LLM_THREADS=6
LLM_THREADS_BATCH=6
# Memory ceiling of the model container. Q4_K_M weights are ~1.5 GB; the
# ceiling leaves room for the KV cache and a larger quantisation.
LLM_MEM_LIMIT=5g
LLM_MEM_RESERVATION=3g
# Image tag: server (CPU) is the portable default; server-cuda, server-vulkan,
# server-rocm or server-intel enable GPU acceleration.
LLM_IMAGE_TAG=server

# ── Misc ─────────────────────────────────────────────────────────────────────
TZ=Europe/Berlin
